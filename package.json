{
  "name": "netrix",
  "private": true,
  "version": "1.0.0",
  "description": "NETRIX — Premium Enterprise Remote Desktop & Remote Support Platform",
  "author": "Pankaj Kushwaha (PB Tech Zone)",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "dist:win": "npm run build && electron-builder --win nsis:x64",
    "dist:portable": "npm run build && electron-builder --win portable:x64",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "com.pbtechzone.netrix",
    "productName": "NETRIX",
    "copyright": "Copyright © 2026 PB Tech Zone - Pankaj Kushwaha",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "NETRIX-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NETRIX Remote"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@popperjs/core": "^2.11.8",
    "@reduxjs/toolkit": "^2.3.0",
    "bootstrap": "^5.3.3",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.0",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.14.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "sass": "^1.82.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vitest": "^2.1.8"
  }
}
